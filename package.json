{
  "name": "bondibai-list",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["web", "worker"],
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm run dev --workspace worker\" \"npm run dev --workspace web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "node test/e2e.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.63.0"
  },
  "engines": {"node": ">=20"}
}
